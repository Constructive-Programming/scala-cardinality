scalaVersion := "3.8.4"

// The skill lands inside the fixture, where the check tasks can inspect it.
cardinalitySkillFile := baseDirectory.value / "seeded" / "SKILL.md"

lazy val checkSkill = taskKey[Unit]("Assert the seeded skill's content.")
checkSkill := {
  val text = IO.read(baseDirectory.value / "seeded" / "SKILL.md")
  val failures = List(
    "frontmatter"     -> text.startsWith("---\nname: cardinality-reduction"),
    "marker"          -> text.contains("Generated by sbt-cardinality"),
    "substitution"    -> text.contains(s"Cardinality reduction in ${baseDirectory.value.getName}"),
    "no placeholders" -> !text.contains("{{"),
  ).collect { case (what, false) => what }
  if (failures.nonEmpty) sys.error(s"seeded skill check failed: ${failures.mkString(", ")}")
}

lazy val checkOwnership = taskKey[Unit]("Assert a user-owned skill file was left untouched.")
checkOwnership := {
  val text = IO.read(baseDirectory.value / "seeded" / "SKILL.md")
  if (text.contains("Generated by sbt-cardinality"))
    sys.error("the task overwrote a file it did not generate")
  if (!text.contains(s"Cardinality reduction in ${baseDirectory.value.getName}"))
    sys.error("the user-owned file no longer reads as seeded")
}

// Simulate a user taking ownership: same seeded content, marker stripped.
lazy val takeSkill = taskKey[Unit]("Strip the generator marker from the seeded skill.")
takeSkill := {
  val file = baseDirectory.value / "seeded" / "SKILL.md"
  IO.write(file, IO.read(file).replaceAll("(?s)<!-- Generated by sbt-cardinality[^>]*-->\\s*", ""))
}
