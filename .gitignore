# sbt build output. sbt 2 writes every module's output under the root
# `target/out/...`, but tools occasionally write module-local target dirs, so
# the pattern is unanchored.
target/
/project/project/

# Tooling / IDE metadata
.bloop/
.bsp/
.metals/
.idea/
.vscode/
metals.sbt

# Generated quality reports. All of these also land under target/ (already
# ignored above); the extra patterns keep them ignored if a tool is ever
# configured to write elsewhere.
**/scoverage-report/
**/stryker4s-report/
**/stryker4s-tmpDir/
/cpd/
